PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080,http://localhost:5173,https://delightful-stack.vercel.app

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Default admin (used only to create the first admin in Supabase Auth;
# change it afterwards from Admin â†’ Settings â†’ Security & Admin Login)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456

# Free Gmail SMTP for order-status emails
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create a Google App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourstore@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM=yourstore@gmail.com